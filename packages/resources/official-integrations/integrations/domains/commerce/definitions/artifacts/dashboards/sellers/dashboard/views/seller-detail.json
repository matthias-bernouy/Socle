{
    "widget": "w-detail",
    "id": "sellerDetail",
    "source": {
        "endpoint": "seller",
        "params": {
            "id": "$selection.id"
        }
    },
    "title": {
        "path": "displayName",
        "fallback": "Seller"
    },
    "status": {
        "path": "verificationStatus"
    },
    "actions": [
        {
            "id": "verifySeller",
            "label": "Verify seller",
            "tone": "primary",
            "placement": "primary",
            "form": {
                "endpoint": "reviewSeller",
                "hiddenFields": [
                    {
                        "name": "id",
                        "value": "$resource.id",
                        "type": "number"
                    },
                    {
                        "name": "expectedVersion",
                        "value": "$resource.version",
                        "type": "number"
                    },
                    {
                        "name": "status",
                        "value": "verified",
                        "type": "string"
                    }
                ],
                "fields": [
                    {
                        "id": "reason",
                        "name": "reason",
                        "label": "Review reason",
                        "path": "reviewReason",
                        "type": "textarea",
                        "rows": 3
                    }
                ]
            }
        },
        {
            "id": "suspendSeller",
            "label": "Suspend seller",
            "tone": "danger",
            "placement": "more",
            "form": {
                "endpoint": "reviewSeller",
                "hiddenFields": [
                    {
                        "name": "id",
                        "value": "$resource.id",
                        "type": "number"
                    },
                    {
                        "name": "expectedVersion",
                        "value": "$resource.version",
                        "type": "number"
                    },
                    {
                        "name": "status",
                        "value": "suspended",
                        "type": "string"
                    }
                ],
                "fields": [
                    {
                        "id": "reason",
                        "name": "reason",
                        "label": "Review reason",
                        "path": "reviewReason",
                        "type": "textarea",
                        "rows": 3
                    }
                ],
                "confirm": "Suspend this seller?"
            }
        }
    ],
    "main": [
        {
            "id": "sellerDetails",
            "title": "Details",
            "fields": [
                {
                    "id": "displayName",
                    "label": "Display name",
                    "path": "displayName",
                    "type": "readonly"
                },
                {
                    "id": "slug",
                    "label": "Slug",
                    "path": "slug",
                    "type": "readonly"
                },
                {
                    "id": "kind",
                    "label": "Kind",
                    "path": "kind",
                    "type": "readonly",
                    "format": "badge"
                },
                {
                    "id": "cmsUserId",
                    "label": "CMS user id",
                    "path": "cmsUserId",
                    "type": "readonly"
                }
            ]
        }
    ]
}
