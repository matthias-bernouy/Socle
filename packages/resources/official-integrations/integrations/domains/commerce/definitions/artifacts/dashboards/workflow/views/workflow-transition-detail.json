[
    {
        "widget": "w-detail",
        "id": "workflowTransitionDetail",
        "source": {
            "endpoint": "workflowTransition",
            "params": {
                "id": "$selection.id"
            }
        },
        "title": {
            "path": "action",
            "fallback": "New workflow transition"
        },
        "actions": [],
        "main": [
            {
                "id": "workflowTransitionFields",
                "title": "Transition",
                "fields": [
                    {
                        "id": "fromState",
                        "label": "From state",
                        "path": "fromState",
                        "type": "combobox",
                        "required": true,
                        "lookup": {
                            "endpoint": "workflowStates",
                            "itemsPath": "items",
                            "valuePath": "code",
                            "labelPath": "label",
                            "subtitlePath": "phase"
                        },
                        "name": "fromState"
                    },
                    {
                        "id": "action",
                        "label": "Action",
                        "path": "action",
                        "type": "text",
                        "required": true,
                        "name": "action"
                    },
                    {
                        "id": "actorKind",
                        "label": "Actor",
                        "path": "actorKind",
                        "type": "select",
                        "required": true,
                        "options": [
                            {
                                "value": "admin",
                                "label": "Administrator"
                            },
                            {
                                "value": "seller",
                                "label": "Seller (core actions only)"
                            }
                        ],
                        "name": "actorKind"
                    },
                    {
                        "id": "toState",
                        "label": "To state",
                        "path": "toState",
                        "type": "combobox",
                        "required": true,
                        "lookup": {
                            "endpoint": "workflowStates",
                            "itemsPath": "items",
                            "valuePath": "code",
                            "labelPath": "label",
                            "subtitlePath": "phase"
                        },
                        "name": "toState"
                    }
                ]
            }
        ],
        "save": {
            "endpoint": "upsertWorkflowTransition",
            "label": "Save transition",
            "idPath": "id"
        },
        "create": {
            "label": "Create"
        }
    }
]
