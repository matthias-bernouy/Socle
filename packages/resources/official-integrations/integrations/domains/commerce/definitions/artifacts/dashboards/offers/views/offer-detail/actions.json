[
    {
        "id": "requestPrice",
        "label": "Request seller price",
        "tone": "primary",
        "placement": "more",
        "form": {
            "endpoint": "reviewOffer",
            "hiddenFields": [
                {
                    "name": "id",
                    "value": "$resource.id",
                    "type": "number"
                },
                {
                    "name": "expectedVersion",
                    "value": "$resource.version",
                    "type": "number"
                },
                {
                    "name": "action",
                    "value": "request_price",
                    "type": "string"
                }
            ],
            "fields": [
                {
                    "id": "minimumAmount",
                    "name": "minimumAmount",
                    "path": "priceRule.minimumAmount",
                    "label": "Minimum price",
                    "type": "money",
                    "required": true,
                    "currencyPath": "currency",
                    "allowDecimals": {
                        "value": "$resource.wholeUnitPrices",
                        "equals": false
                    }
                },
                {
                    "id": "maximumAmount",
                    "name": "maximumAmount",
                    "path": "priceRule.maximumAmount",
                    "label": "Maximum price",
                    "type": "money",
                    "required": true,
                    "currencyPath": "currency",
                    "allowDecimals": {
                        "value": "$resource.wholeUnitPrices",
                        "equals": false
                    }
                },
                {
                    "id": "reason",
                    "name": "reason",
                    "label": "Review note",
                    "path": "reviewReason",
                    "type": "textarea",
                    "rows": 3
                }
            ]
        },
        "visibleWhen": {
            "value": "$resource.id",
            "notEquals": null
        }
    },
    {
        "id": "approveOffer",
        "label": "Approve offer",
        "tone": "primary",
        "placement": "more",
        "form": {
            "endpoint": "reviewOffer",
            "hiddenFields": [
                {
                    "name": "id",
                    "value": "$resource.id",
                    "type": "number"
                },
                {
                    "name": "expectedVersion",
                    "value": "$resource.version",
                    "type": "number"
                },
                {
                    "name": "action",
                    "value": "approve",
                    "type": "string"
                }
            ],
            "fields": [
                {
                    "id": "reason",
                    "name": "reason",
                    "label": "Review note",
                    "path": "reviewReason",
                    "type": "textarea",
                    "rows": 3
                }
            ]
        },
        "visibleWhen": {
            "value": "$resource.id",
            "notEquals": null
        }
    },
    {
        "id": "rejectOffer",
        "label": "Reject offer",
        "tone": "danger",
        "placement": "more",
        "form": {
            "endpoint": "reviewOffer",
            "hiddenFields": [
                {
                    "name": "id",
                    "value": "$resource.id",
                    "type": "number"
                },
                {
                    "name": "expectedVersion",
                    "value": "$resource.version",
                    "type": "number"
                },
                {
                    "name": "action",
                    "value": "reject",
                    "type": "string"
                }
            ],
            "fields": [
                {
                    "id": "reason",
                    "name": "reason",
                    "label": "Review note",
                    "path": "reviewReason",
                    "type": "textarea",
                    "rows": 3
                }
            ],
            "confirm": "Reject this offer?"
        },
        "visibleWhen": {
            "value": "$resource.id",
            "notEquals": null
        }
    }
]
