{
    "widget": "w-detail",
    "id": "brandDetail",
    "source": {
        "endpoint": "manageBrand",
        "params": {
            "id": "$selection.id"
        }
    },
    "title": {
        "path": "name",
        "fallback": "New brand"
    },
    "status": {
        "path": "status"
    },
    "main": [
        {
            "id": "brandDetails",
            "title": "Brand",
            "fields": [
                {
                    "id": "slug",
                    "label": "Slug",
                    "path": "slug",
                    "type": "text",
                    "required": true
                },
                {
                    "id": "name",
                    "label": "Name",
                    "path": "name",
                    "type": "text",
                    "required": true
                },
                {
                    "id": "description",
                    "label": "Description",
                    "path": "description",
                    "type": "textarea",
                    "rows": 4
                }
            ]
        }
    ],
    "aside": [
        {
            "id": "brandState",
            "title": "State",
            "fields": [
                {
                    "id": "status",
                    "label": "Status",
                    "path": "status",
                    "type": "select",
                    "required": true,
                    "options": [
                        {
                            "value": "active",
                            "label": "Active"
                        },
                        {
                            "value": "archived",
                            "label": "Archived"
                        }
                    ]
                },
                {
                    "id": "id",
                    "label": "Identifier",
                    "path": "id",
                    "type": "readonly"
                }
            ]
        }
    ],
    "create": {
        "label": "Create brand",
        "title": "New brand"
    },
    "save": {
        "endpoint": "upsertBrand",
        "label": "Save brand",
        "hiddenFields": [
            {
                "name": "id",
                "value": "$resource.id",
                "type": "number",
                "empty": "omit"
            },
            {
                "name": "expectedVersion",
                "value": "$resource.version",
                "type": "number",
                "empty": "omit"
            }
        ]
    },
    "delete": {
        "endpoint": "deleteBrand",
        "label": "Delete brand",
        "tone": "danger",
        "confirm": "Delete this brand?",
        "hiddenFields": [
            {
                "name": "id",
                "value": "$resource.id",
                "type": "number",
                "empty": "omit"
            }
        ]
    }
}
