            "opens": "workflowStateDetail"
        },
        "create": {
            "viewId": "workflowStateDetail",
            "presentation": "page",
            "label": "Create state"
        }
    },
    {
        "widget": "w-table",
        "id": "workflowTransitionsTable",
        "title": "Offer workflow transitions",
        "source": {
            "endpoint": "workflowTransitions",
            "itemsPath": "items",
            "totalPath": "total"
        },
        "rowKey": "id",
        "columns": [
            {
                "id": "action",
                "label": "Action",
                "path": "action",
                "primary": true
            },
            {
                "id": "fromState",
                "label": "From",
                "path": "fromState"
            },
            {
                "id": "toState",
                "label": "To",
                "path": "toState"
            },
            {
                "id": "actorKind",
                "label": "Actor",
                "path": "actorKind",
                "format": "badge"
            }
        ],
        "actions": [],
        "selection": {
