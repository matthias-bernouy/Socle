            "totalPath": "total"
        },
        "rowKey": "code",
        "columns": [
            {
                "id": "label",
                "label": "State",
                "path": "label",
                "primary": true
            },
            {
                "id": "code",
                "label": "Code",
                "path": "code"
            },
            {
                "id": "phase",
                "label": "Phase",
                "path": "phase",
                "format": "badge"
            },
            {
                "id": "enabled",
                "label": "Enabled",
                "path": "enabled",
                "format": "badge"
            }
        ],
        "actions": [],
