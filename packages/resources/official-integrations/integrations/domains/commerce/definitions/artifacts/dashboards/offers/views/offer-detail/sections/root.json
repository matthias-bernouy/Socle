[
    {
        "$include": "offer-details.json"
    },
    {
        "id": "offerMedia",
        "title": "Images",
        "fields": [
            {
                "id": "media",
                "label": "Images",
                "path": "media",
                "type": "media",
                "multiple": true,
                "item": {
                    "idPath": "media.id",
                    "urlPath": "media.url",
                    "altPath": "media.alt",
                    "endpoint": "offerImage"
                },
                "actions": {
                    "upload": {
                        "endpoint": "stageOfferImage"
                    }
                },
                "name": "mediaIds",
                "persist": "save",
                "valueType": "number",
                "staging": {
                    "sessionField": "uploadSessionId"
                }
            }
        ]
    },
    {
        "id": "offerPricing",
        "title": "Pricing",
        "fields": [
            {
                "id": "acceptedPriceAmount",
                "label": "Accepted price amount",
                "path": "acceptedPriceAmount",
                "type": "money",
                "currencyPath": "currency",
                "allowDecimals": {
                    "value": "$resource.wholeUnitPrices",
                    "equals": false
                },
                "empty": "null"
            },
            {
                "id": "currency",
                "label": "Currency",
                "path": "currency",
                "type": "text",
                "required": true
            }
        ]
    }
]
