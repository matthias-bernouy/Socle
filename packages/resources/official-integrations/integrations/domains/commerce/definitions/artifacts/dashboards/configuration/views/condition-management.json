[
    {
        "widget": "w-table",
        "id": "conditionsTable",
        "title": "Offer conditions",
        "source": {
            "endpoint": "offerConditions",
            "itemsPath": "items",
            "totalPath": "total"
        },
        "rowKey": "code",
        "columns": [
            {
                "id": "label",
                "label": "Condition",
                "path": "label",
                "primary": true
            },
            {
                "id": "code",
                "label": "Code",
                "path": "code"
            },
            {
                "id": "position",
                "label": "Position",
                "path": "position"
            },
            {
                "id": "enabled",
                "label": "Enabled",
                "path": "enabled",
                "format": "badge"
            }
        ],
        "actions": [],
        "selection": {
            "opens": "conditionDetail"
        },
        "create": {
            "viewId": "conditionDetail",
            "presentation": "page",
            "label": "Create condition"
        }
    },
    {
        "widget": "w-detail",
        "id": "conditionDetail",
        "source": {
            "endpoint": "offerCondition",
            "params": {
                "code": "$selection.id"
            }
        },
        "title": {
            "path": "label",
            "fallback": "New offer condition"
        },
        "actions": [],
        "main": [
            {
                "id": "conditionFields",
                "title": "Condition",
                "fields": [
                    {
                        "id": "code",
                        "label": "Code",
                        "path": "code",
                        "type": "text",
                        "required": true,
                        "name": "code"
                    },
                    {
                        "id": "label",
                        "label": "Label",
                        "path": "label",
                        "type": "text",
                        "required": true,
                        "name": "label"
                    },
                    {
                        "id": "description",
                        "label": "Description",
                        "path": "description",
                        "type": "textarea",
                        "rows": 3,
                        "name": "description"
                    },
                    {
                        "id": "position",
                        "label": "Position",
                        "path": "position",
                        "type": "number",
                        "name": "position",
                        "valueType": "number",
                        "empty": "omit"
                    },
                    {
                        "id": "enabled",
                        "label": "Enabled",
                        "path": "enabled",
                        "type": "select",
                        "options": [
                            {
                                "value": "true",
                                "label": "Yes"
                            },
                            {
                                "value": "false",
                                "label": "No"
                            }
                        ],
                        "name": "enabled",
                        "valueType": "boolean"
                    }
                ]
            }
        ],
        "save": {
            "endpoint": "upsertOfferCondition",
            "label": "Save condition",
            "idPath": "code"
        },
        "create": {
            "label": "Create condition"
        }
    }
]
