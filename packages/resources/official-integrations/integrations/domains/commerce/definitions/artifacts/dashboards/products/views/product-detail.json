{
    "widget": "w-detail",
    "id": "productDetail",
    "source": {
        "endpoint": "manageProduct",
        "params": {
            "id": "$selection.id"
        }
    },
    "title": {
        "path": "title",
        "fallback": "New product"
    },
    "status": {
        "path": "status"
    },
    "main": {
        "$include": "product-detail/sections/root.json"
    },
    "aside": [
        {
            "id": "productState",
            "title": "State",
            "fields": [
                {
                    "id": "status",
                    "label": "Status",
                    "path": "status",
                    "type": "select",
                    "required": true,
                    "options": [
                        {
                            "value": "draft",
                            "label": "Draft"
                        },
                        {
                            "value": "active",
                            "label": "Active"
                        },
                        {
                            "value": "archived",
                            "label": "Archived"
                        }
                    ]
                },
                {
                    "id": "visibility",
                    "label": "Visibility",
                    "path": "visibility",
                    "type": "select",
                    "required": true,
                    "options": [
                        {
                            "value": "public",
                            "label": "Public"
                        },
                        {
                            "value": "hidden",
                            "label": "Hidden"
                        }
                    ]
                }
            ]
        },
        {
            "id": "productClassification",
            "title": "Classification",
            "fields": [
                {
                    "id": "brandId",
                    "label": "Brand",
                    "path": "brandId",
                    "type": "combobox",
                    "lookup": {
                        "endpoint": "manageBrands",
                        "params": {
                            "q": "$search",
                            "limit": "20"
                        },
                        "itemsPath": "items",
                        "valuePath": "id",
                        "labelPath": "name",
                        "subtitlePath": "slug",
                        "selected": "$resource.brand",
                        "create": {
                            "dashboardId": "commerce-taxonomy",
                            "viewId": "brandDetail",
                            "presentation": "modal",
                            "valuePath": "id",
                            "labelPath": "name",
                            "label": "Create brand",
                            "title": "Create brand"
                        },
                        "edit": {
                            "dashboardId": "commerce-taxonomy",
                            "viewId": "brandDetail",
                            "presentation": "modal",
                            "valuePath": "id",
                            "labelPath": "name",
                            "label": "Edit brand",
                            "title": "Edit brand"
                        }
                    },
                    "empty": "null",
                    "valueType": "number"
                },
                {
                    "id": "primaryCategoryId",
                    "label": "Primary category",
                    "path": "primaryCategoryId",
                    "type": "combobox",
                    "lookup": {
                        "endpoint": "manageCategories",
                        "params": {
                            "q": "$search",
                            "limit": "20"
                        },
                        "itemsPath": "items",
                        "valuePath": "id",
                        "labelPath": "label",
                        "subtitlePath": "fullSlug",
                        "selected": "$resource.primaryCategory"
                    },
                    "empty": "null",
                    "valueType": "number"
                }
            ]
        }
    ],
    "save": {
        "endpoint": "upsertProduct",
        "label": "Save product",
        "hiddenFields": [
            {
                "name": "id",
                "value": "$resource.id",
                "type": "number",
                "empty": "omit"
            },
            {
                "name": "expectedVersion",
                "value": "$resource.version",
                "type": "number",
                "empty": "omit"
            },
            {
                "name": "creationToken",
                "value": "$resource.creationToken",
                "type": "string",
                "empty": "omit"
            }
        ]
    },
    "create": {
        "label": "Create product",
        "title": "New product"
    }
}
