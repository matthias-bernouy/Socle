[
    {
        "widget": "w-navigation-list",
        "id": "brandsTable",
        "title": "Brands",
        "source": {
            "endpoint": "manageBrands",
            "params": {
                "limit": "100"
            },
            "itemsPath": "items"
        },
        "rowKey": "id",
        "item": {
            "title": {
                "path": "name"
            },
            "subtitle": {
                "path": "slug"
            },
            "badge": {
                "path": "status"
            }
        },
        "reorderable": {
            "action": "reorderBrands"
        },
        "actions": [
            {
                "id": "reorderBrands",
                "label": "Reorder brands",
                "form": {
                    "endpoint": "reorderBrands"
                }
            }
        ],
        "selection": {
            "opens": "brandDetail"
        },
        "create": {
            "viewId": "brandDetail",
            "presentation": "page",
            "label": "Create brand",
            "title": "New brand"
        }
    },
    {
        "widget": "w-navigation-list",
        "id": "categoriesTable",
        "title": "Categories",
        "source": {
            "endpoint": "manageCategories",
            "params": {
                "limit": "200"
            },
            "itemsPath": "items"
        },
        "rowKey": "id",
        "item": {
            "title": {
                "path": "label"
            },
            "subtitle": {
                "path": "fullSlug"
            },
            "badge": {
                "path": "status"
            }
        },
        "reorderable": {
            "action": "reorderCategories"
        },
        "actions": [
            {
                "id": "reorderCategories",
                "label": "Reorder categories",
                "form": {
                    "endpoint": "reorderCategories"
                }
            }
        ],
        "selection": {
            "opens": "categoryDetail"
        },
        "create": {
            "viewId": "categoryDetail",
            "presentation": "page",
            "label": "Create category",
            "title": "New category"
        }
    },
    {
        "$include": "brand-detail.json"
    }
]
