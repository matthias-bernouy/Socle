{
    "widget": "w-detail",
    "id": "workflowStateDetail",
    "source": {
        "endpoint": "workflowState",
        "params": {
            "code": "$selection.id"
        }
    },
    "title": {
        "path": "label",
        "fallback": "New workflow state"
    },
    "status": {
        "path": "phase"
    },
    "actions": [],
    "main": [
        {
            "id": "workflowStateFields",
            "title": "State",
            "fields": [
                {
                    "id": "code",
                    "label": "Code",
                    "path": "code",
                    "type": "text",
                    "required": true,
                    "name": "code"
                },
                {
                    "id": "label",
                    "label": "Label",
                    "path": "label",
                    "type": "text",
                    "required": true,
                    "name": "label"
                },
                {
                    "id": "phase",
                    "label": "Phase",
                    "path": "phase",
                    "type": "select",
                    "required": true,
                    "options": [
                        {
                            "value": "draft",
                            "label": "Draft"
                        },
                        {
                            "value": "seller_input",
                            "label": "Seller input"
                        },
                        {
                            "value": "admin_review",
                            "label": "Administrator review"
                        },
                        {
                            "value": "ready",
                            "label": "Ready"
                        },
                        {
                            "value": "terminal",
                            "label": "Terminal"
                        }
                    ],
                    "name": "phase"
                },
                {
                    "id": "position",
                    "label": "Position",
                    "path": "position",
                    "type": "number",
                    "name": "position",
                    "valueType": "number",
                    "empty": "omit"
                },
                {
                    "id": "enabled",
                    "label": "Enabled",
                    "path": "enabled",
                    "type": "select",
                    "options": [
                        {
                            "value": "true",
                            "label": "Yes"
                        },
                        {
                            "value": "false",
                            "label": "No"
                        }
                    ],
                    "name": "enabled",
                    "valueType": "boolean"
                },
                {
                    "id": "terminal",
                    "label": "Terminal",
                    "path": "terminal",
                    "type": "select",
                    "options": [
                        {
                            "value": "true",
                            "label": "Yes"
                        },
                        {
                            "value": "false",
                            "label": "No"
                        }
                    ],
                    "name": "terminal",
                    "valueType": "boolean"
                }
            ]
        }
    ],
    "save": {
        "endpoint": "upsertWorkflowState",
        "label": "Save state",
        "idPath": "code"
    },
    "create": {
        "label": "Create state"
    }
}
