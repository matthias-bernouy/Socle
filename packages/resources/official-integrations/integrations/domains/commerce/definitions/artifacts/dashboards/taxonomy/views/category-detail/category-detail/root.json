{
    "widget": "w-detail",
    "id": "categoryDetail",
    "source": {
        "endpoint": "manageCategory",
        "params": {
            "id": "$selection.id"
        }
    },
    "title": {
        "path": "label",
        "fallback": "New category"
    },
    "status": {
        "path": "status"
    },
    "main": {
        "$include": "main.json"
    },
    "aside": [
        {
            "id": "categoryState",
            "title": "State",
            "fields": [
                {
                    "id": "status",
                    "label": "Status",
                    "path": "status",
                    "type": "select",
                    "required": true,
                    "options": [
                        {
                            "value": "active",
                            "label": "Active"
                        },
                        {
                            "value": "archived",
                            "label": "Archived"
                        }
                    ]
                },
                {
                    "id": "id",
                    "label": "Identifier",
                    "path": "id",
                    "type": "readonly"
                }
            ]
        }
    ],
    "create": {
        "label": "Create category",
        "title": "New category"
    },
    "save": {
        "endpoint": "upsertCategory",
        "label": "Save category",
        "hiddenFields": [
            {
                "name": "id",
                "value": "$resource.id",
                "type": "number",
                "empty": "omit"
            },
            {
                "name": "expectedVersion",
                "value": "$resource.version",
                "type": "number",
                "empty": "omit"
            }
        ]
    },
    "delete": {
        "endpoint": "deleteCategory",
        "label": "Delete category",
        "tone": "danger",
        "confirm": "Delete this category?",
        "hiddenFields": [
            {
                "name": "id",
                "value": "$resource.id",
                "type": "number",
                "empty": "omit"
            }
        ]
    }
}
