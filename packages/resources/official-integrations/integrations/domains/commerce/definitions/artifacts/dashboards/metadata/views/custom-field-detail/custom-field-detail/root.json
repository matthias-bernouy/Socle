{
    "widget": "w-detail",
    "id": "customFieldDetail",
    "source": {
        "endpoint": "customField",
        "params": {
            "id": "$selection.id"
        }
    },
    "title": {
        "path": "label",
        "fallback": "New metadata definition"
    },
    "status": {
        "path": "fieldType"
    },
    "actions": [],
    "main": {
        "$include": "main.json"
    },
    "aside": {
        "$include": "aside.json"
    },
    "save": {
        "endpoint": "upsertCustomField",
        "label": "Save metadata",
        "idPath": "id"
    },
    "delete": {
        "endpoint": "deleteCustomField",
        "confirm": "Delete this metadata definition?",
        "hiddenFields": [
            {
                "name": "entityType",
                "value": "$resource.entityType",
                "type": "string"
            },
            {
                "name": "key",
                "value": "$resource.key",
                "type": "string"
            }
        ],
        "label": "Delete metadata",
        "tone": "danger"
    },
    "create": {
        "label": "Create"
    }
}
