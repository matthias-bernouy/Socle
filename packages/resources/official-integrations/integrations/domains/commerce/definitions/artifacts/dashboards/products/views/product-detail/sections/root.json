[
    {
        "id": "productDetails",
        "title": "Details",
        "fields": [
            {
                "id": "slug",
                "label": "Slug",
                "path": "slug",
                "type": "text"
            },
            {
                "id": "title",
                "label": "Title",
                "path": "title",
                "type": "text",
                "required": true
            },
            {
                "id": "description",
                "label": "Description",
                "path": "description",
                "type": "textarea",
                "rows": 5
            }
        ]
    },
    {
        "id": "categoryMetadata",
        "title": "Category metadata",
        "description": "Fields required by the selected primary category.",
        "fields": [
            {
                "id": "metadata",
                "label": "Metadata",
                "path": "metadata",
                "type": "schema",
                "schema": {
                    "endpoint": "categoryProductFields",
                    "params": {
                        "categoryId": "$field.primaryCategoryId"
                    },
                    "itemsPath": "fields"
                },
                "exclude": {
                    "from": "$field.variantAxes",
                    "valuePath": "fieldKey"
                }
            }
        ]
    },
    {
        "id": "productMedia",
        "title": "Images",
        "fields": [
            {
                "id": "media",
                "label": "Images",
                "path": "media",
                "type": "media",
                "multiple": true,
                "item": {
                    "idPath": "media.id",
                    "urlPath": "media.url",
                    "altPath": "media.alt",
                    "endpoint": "productImage"
                },
                "actions": {
                    "upload": {
                        "endpoint": "stageProductImage"
                    }
                },
                "name": "mediaIds",
                "persist": "save",
                "valueType": "number",
                "staging": {
                    "sessionField": "uploadSessionId"
                }
            }
        ]
    },
    {
        "$include": "product-variants.json"
    }
]
