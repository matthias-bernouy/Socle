{
    "widget": "w-detail",
    "id": "commerceSettings",
    "source": {
        "endpoint": "settings"
    },
    "title": {
        "path": "mode",
        "fallback": "Commerce settings"
    },
    "status": {
        "path": "mode"
    },
    "actions": [],
    "main": {
        "$include": "main.json"
    },
    "save": {
        "endpoint": "updateSettings",
        "hiddenFields": [
            {
                "name": "expectedVersion",
                "value": "$resource.version",
                "type": "number"
            }
        ],
        "label": "Save settings"
    }
}
