                        "label": "Seller"
                    },
                    {
                        "value": "offer",
                        "label": "Offer"
                    },
                    {
                        "value": "order",
                        "label": "Order"
                    }
                ],
                "name": "entityType"
            },
            {
                "id": "key",
                "label": "Key",
                "path": "key",
                "type": "text",
                "required": true,
                "name": "key"
            },
            {
                "id": "label",
                "label": "Label",
                "path": "label",
                "type": "text",
                "required": true,
                "name": "label"
            },
            {
                "id": "fieldType",
                "label": "Type",
                "path": "fieldType",
