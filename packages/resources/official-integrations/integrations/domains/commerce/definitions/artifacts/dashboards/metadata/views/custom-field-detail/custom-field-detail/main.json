                "required": true,
                "options": [
                    {
                        "value": "string",
                        "label": "Text"
                    },
                    {
                        "value": "number",
                        "label": "Number"
                    },
                    {
                        "value": "boolean",
                        "label": "Boolean"
                    },
                    {
                        "value": "enum",
