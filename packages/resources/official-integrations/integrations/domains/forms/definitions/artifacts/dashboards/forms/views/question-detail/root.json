{
    "widget": "w-detail",
    "id": "questionDetail",
    "source": {
        "endpoint": "manageQuestion",
        "params": {
            "ref": "$selection.id"
        }
    },
    "title": {
        "path": "label",
        "fallback": "Question"
    },
    "status": {
        "path": "type"
    },
    "actions": {
        "$include": "actions.json"
    },
    "main": {
        "$files": [
            "question-fields.json",
            "choices.json"
        ]
    },
    "aside": {
        "$files": [
            "metadata.json"
        ]
    },
    "save": {
        "endpoint": "saveQuestion",
        "label": "Save question",
        "hiddenFields": [
            {
                "name": "ref",
                "type": "string",
                "value": "$resource.ref"
            }
        ]
    }
}
