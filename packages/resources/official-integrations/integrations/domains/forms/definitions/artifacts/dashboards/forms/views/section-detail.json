[
    {
        "widget": "w-detail",
        "id": "sectionDetail",
        "source": {
            "endpoint": "manageSection",
            "params": {
                "ref": "$selection.id"
            }
        },
        "title": {
            "path": "title",
            "fallback": "Section"
        },
        "status": {
            "path": "badge"
        },
        "actions": [
            {
                "id": "backToForm",
                "label": "Form settings",
                "placement": "secondary",
                "selection": {
                    "opens": "formDetail",
                    "row": "$resource.formKey"
                }
            }
        ],
        "main": [
            {
                "id": "sectionContent",
                "title": "Section content",
                "description": "Questions are managed from the ordered list below.",
                "fields": [
                    {
                        "id": "title",
                        "label": "Title",
                        "path": "title",
                        "type": "text",
                        "required": true,
                        "name": "title"
                    },
                    {
                        "id": "description",
                        "label": "Description",
                        "path": "description",
                        "type": "textarea",
                        "rows": 3,
                        "name": "description"
                    }
                ]
            },
            {
                "widget": "w-navigation-list",
                "id": "questionNavigation",
                "title": "Questions",
                "description": "Open a question to configure its type and choices. Drag questions to reorder them.",
                "source": {
                    "endpoint": "manageQuestions",
                    "params": {
                        "context": "$selection.sectionDetail.id"
                    },
                    "itemsPath": "items"
                },
                "rowKey": "id",
                "item": {
                    "title": {
                        "path": "title"
                    },
                    "subtitle": {
                        "path": "subtitle"
                    },
                    "badge": {
                        "path": "badge"
                    }
                },
                "selection": {
                    "opens": "questionDetail"
                },
                "reorderable": {
                    "action": "reorderQuestions"
                },
                "actions": [
                    {
                        "id": "createQuestion",
                        "label": "Add question",
                        "tone": "primary",
                        "placement": "primary",
                        "endpoint": {
                            "endpoint": "createQuestion",
                            "body": {
                                "context": "$selection.sectionDetail.id"
                            }
                        },
                        "after": {
                            "opens": "questionDetail",
                            "row": "$result.ref",
                            "resource": "$result"
                        }
                    },
                    {
                        "id": "reorderQuestions",
                        "label": "Reorder questions",
                        "endpoint": {
                            "endpoint": "reorderQuestions",
                            "body": {
                                "context": "$selection.sectionDetail.id",
                                "refs": "$value"
                            }
                        }
                    }
                ]
            }
        ],
        "aside": [
            {
                "id": "sectionMetadata",
                "title": "Structure",
                "fields": [
                    {
                        "id": "sectionId",
                        "label": "Stable id",
                        "path": "sectionId",
                        "type": "readonly"
                    },
                    {
                        "id": "questionCount",
                        "label": "Questions",
                        "path": "questionCount",
                        "type": "readonly"
                    },
                    {
                        "id": "formKey",
                        "label": "Form",
                        "path": "formKey",
                        "type": "readonly"
                    }
                ]
            }
        ],
        "save": {
            "endpoint": "saveSection",
            "hiddenFields": [
                {
                    "name": "ref",
                    "value": "$resource.ref",
                    "type": "string"
                }
            ],
            "label": "Save section"
        },
        "delete": {
            "endpoint": "deleteSection",
            "confirm": "Delete this section and every question it contains?",
            "hiddenFields": [
                {
                    "name": "ref",
                    "value": "$resource.ref",
                    "type": "string"
                }
            ],
            "label": "Delete section",
            "tone": "danger"
        }
    }
]
