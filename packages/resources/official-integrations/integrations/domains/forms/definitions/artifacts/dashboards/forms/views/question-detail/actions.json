[
    {
        "id": "backToSection",
        "label": "Section",
        "placement": "secondary",
        "selection": {
            "opens": "sectionDetail",
            "row": "$resource.sectionRef"
        }
    },
    {
        "id": "deleteQuestion",
        "label": "Delete question",
        "tone": "danger",
        "placement": "more",
        "confirm": "Delete this question? Existing published versions and responses remain unchanged.",
        "endpoint": {
            "endpoint": "deleteQuestion",
            "body": {
                "ref": "$resource.ref"
            }
        },
        "after": {
            "opens": "sectionDetail",
            "row": "$result.sectionRef"
        }
    }
]
