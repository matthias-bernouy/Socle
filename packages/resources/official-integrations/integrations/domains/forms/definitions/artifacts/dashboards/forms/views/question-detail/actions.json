[
    {
        "id": "backToSection",
        "label": "Section",
        "placement": "secondary",
        "selection": {
            "opens": "sectionDetail",
            "row": "$resource.sectionRef"
        }
    },
    {
        "id": "deleteQuestion",
        "label": "Delete question",
        "tone": "danger",
        "placement": "more",
        "confirm": "Delete this question? Existing published versions and responses remain unchanged.",
        "after": {
            "opens": "sectionDetail",
            "row": "$result.sectionRef"
        },
        "form": {
            "endpoint": "deleteQuestion",
            "refresh": "none",
            "hiddenFields": [
                {
                    "name": "ref",
                    "type": "string",
                    "value": "$resource.ref"
                }
            ]
        }
    }
]
