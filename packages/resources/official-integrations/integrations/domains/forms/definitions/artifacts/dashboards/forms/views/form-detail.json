[
    {
        "widget": "w-detail",
        "id": "formDetail",
        "source": {
            "endpoint": "manageForm",
            "params": {
                "key": "$selection.id"
            }
        },
        "title": {
            "path": "title",
            "fallback": "New form"
        },
        "status": {
            "path": "status"
        },
        "actions": {
            "$include": "form-actions.json"
        },
        "main": [
            {
                "id": "identity",
                "title": "Form settings",
                "description": "Save the form, then build its sections and questions below.",
                "fields": [
                    {
                        "id": "title",
                        "label": "Title",
                        "path": "title",
                        "type": "text",
                        "required": true
                    },
                    {
                        "id": "newKey",
                        "label": "Stable key",
                        "path": "key",
                        "name": "key",
                        "type": "text",
                        "required": true,
                        "visibleWhen": {
                            "value": "$resource.id",
                            "equals": null
                        }
                    },
                    {
                        "id": "key",
                        "label": "Stable key",
                        "path": "key",
                        "type": "readonly",
                        "visibleWhen": {
                            "value": "$resource.id",
                            "notEquals": null
                        }
                    },
                    {
                        "id": "description",
                        "label": "Description",
                        "path": "description",
                        "type": "textarea",
                        "rows": 3
                    },
                    {
                        "id": "accessMode",
                        "label": "Visitor access",
                        "path": "accessMode",
                        "type": "select",
                        "required": true,
                        "options": [
                            {
                                "value": "public",
                                "label": "Public"
                            },
                            {
                                "value": "authenticated",
                                "label": "Signed-in visitors"
                            }
                        ]
                    }
                ]
            },
            {
                "widget": "w-navigation-list",
                "id": "sectionNavigation",
                "title": "Sections",
                "description": "Open a section to manage its questions. Drag sections to change the visitor journey.",
                "source": {
                    "endpoint": "manageSections",
                    "params": {
                        "context": "$selection.formDetail.id"
                    },
                    "itemsPath": "items"
                },
                "rowKey": "id",
                "item": {
                    "title": {
                        "path": "title"
                    },
                    "subtitle": {
                        "path": "subtitle"
                    },
                    "badge": {
                        "path": "badge"
                    }
                },
                "selection": {
                    "opens": "sectionDetail"
                },
                "reorderable": {
                    "action": "reorderSections",
                    "name": "refs"
                },
                "actions": [
                    {
                        "id": "createSection",
                        "label": "Add section",
                        "tone": "primary",
                        "placement": "primary",
                        "after": {
                            "opens": "sectionDetail",
                            "row": "$result.ref"
                        },
                        "form": {
                            "endpoint": "createSection",
                            "refresh": "none",
                            "hiddenFields": [
                                {
                                    "name": "context",
                                    "type": "string",
                                    "value": "$resource.key"
                                }
                            ]
                        }
                    },
                    {
                        "id": "reorderSections",
                        "label": "Reorder sections",
                        "form": {
                            "endpoint": "reorderSections",
                            "hiddenFields": [
                                {
                                    "name": "context",
                                    "type": "string",
                                    "value": "$resource.key"
                                }
                            ]
                        }
                    }
                ]
            }
        ],
        "aside": [
            {
                "id": "publication",
                "title": "Publication",
                "fields": [
                    {
                        "id": "status",
                        "label": "Status",
                        "path": "status",
                        "type": "readonly",
                        "format": "badge"
                    },
                    {
                        "id": "version",
                        "label": "Published version",
                        "path": "version",
                        "type": "readonly"
                    },
                    {
                        "id": "publishedAt",
                        "label": "Published",
                        "path": "publishedAt",
                        "type": "readonly",
                        "format": "date"
                    }
                ]
            }
        ],
        "create": {},
        "save": {
            "endpoint": "saveFormDraft",
            "idPath": "key",
            "label": "Save form",
            "hiddenFields": [
                {
                    "name": "id",
                    "type": "number",
                    "value": "$resource.id",
                    "empty": "omit"
                }
            ]
        }
    }
]
