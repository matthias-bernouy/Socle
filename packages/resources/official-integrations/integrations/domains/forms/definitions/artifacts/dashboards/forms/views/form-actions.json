[
    {
        "id": "publishForm",
        "label": "Publish new version",
        "tone": "primary",
        "placement": "more",
        "visibleWhen": {
            "value": "$resource.key",
            "notEquals": ""
        },
        "form": {
            "endpoint": "publishForm",
            "hiddenFields": [
                {
                    "name": "key",
                    "value": "$resource.key",
                    "type": "string"
                }
            ],
            "confirm": "Publish the current draft as a new immutable version?"
        }
    },
    {
        "id": "archiveForm",
        "label": "Archive form",
        "tone": "danger",
        "placement": "more",
        "visibleWhen": {
            "value": "$resource.key",
            "notEquals": ""
        },
        "form": {
            "endpoint": "archiveForm",
            "hiddenFields": [
                {
                    "name": "key",
                    "value": "$resource.key",
                    "type": "string"
                }
            ],
            "confirm": "Archive this form? Published rendering and new submissions will stop."
        }
    }
]
