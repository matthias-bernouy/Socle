{
    "widget": "w-detail",
    "id": "extraFieldDetail",
    "source": {
        "endpoint": "getExtraField",
        "params": {
            "id": "$selection.id"
        },
        "itemPath": "field"
    },
    "title": {
        "path": "label",
        "fallback": "New field"
    },
    "status": {
        "path": "type"
    },
    "actions": [],
    "main": {
        "$include": "main.json"
    },
    "aside": [
        {
            "id": "notes",
            "title": "Usage",
            "fields": [
                {
                    "id": "overlay",
                    "label": "Overlay",
                    "path": "id",
                    "type": "readonly",
                    "format": "badge"
                }
            ]
        }
    ],
    "save": {
        "endpoint": "createExtraField",
        "hiddenFields": [
            {
                "name": "id",
                "value": "$resource.id",
                "type": "string",
                "empty": "omit"
            }
        ],
        "label": "Save field",
        "idPath": "field.id"
    },
    "delete": {
        "endpoint": "deleteExtraField",
        "confirm": "Delete this field definition? Existing user metadata values will be kept.",
        "hiddenFields": [
            {
                "name": "id",
                "value": "$resource.id",
                "type": "string"
            }
        ],
        "label": "Delete field",
        "tone": "danger"
    },
    "create": {
        "label": "Create"
    }
}
