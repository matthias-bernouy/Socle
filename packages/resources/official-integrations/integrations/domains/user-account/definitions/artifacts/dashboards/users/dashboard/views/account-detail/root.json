{
    "widget": "w-detail",
    "id": "accountDetail",
    "source": {
        "endpoint": "getAccountByUserId",
        "params": {
            "userId": "$selection.id"
        }
    },
    "title": {
        "path": "givenName",
        "fallback": "User"
    },
    "actions": [],
    "main": {
        "$include": "main.json"
    },
    "aside": [
        {
            "id": "avatar",
            "title": "Avatar",
            "fields": [
                {
                    "id": "avatarPreview",
                    "label": "Avatar",
                    "path": "avatarUrl",
                    "type": "readonly",
                    "format": "image"
                }
            ]
        },
        {
            "id": "accountMetadata",
            "title": "Metadata",
            "fields": [
                {
                    "id": "createdAt",
                    "label": "Created",
                    "path": "createdAt",
                    "type": "readonly",
                    "format": "date"
                },
                {
                    "id": "updatedAt",
                    "label": "Updated",
                    "path": "updatedAt",
                    "type": "readonly",
                    "format": "date"
                }
            ]
        }
    ],
    "save": {
        "endpoint": "createUserPersonalInformation",
        "hiddenFields": [
            {
                "name": "userId",
                "value": "$resource.userId",
                "type": "string"
            }
        ],
        "label": "Save user"
    },
    "delete": {
        "endpoint": "deleteUserPersonalInformation",
        "confirm": "Delete this user's personal information?",
        "hiddenFields": [
            {
                "name": "userId",
                "value": "$resource.userId",
                "type": "string"
            }
        ],
        "label": "Delete user",
        "tone": "danger"
    }
}
