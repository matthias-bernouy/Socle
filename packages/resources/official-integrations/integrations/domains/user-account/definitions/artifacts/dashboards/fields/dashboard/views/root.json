[
    {
        "widget": "w-navigation-list",
        "id": "extraFieldsTable",
        "title": "Personal information fields",
        "source": {
            "endpoint": "listExtraFields",
            "itemsPath": "fields"
        },
        "rowKey": "id",
        "item": {
            "title": {
                "path": "label"
            },
            "badge": {
                "path": "type"
            }
        },
        "selection": {
            "opens": "extraFieldDetail"
        },
        "reorderable": {
            "action": "reorderExtraFields"
        },
        "actions": [
            {
                "id": "reorderExtraFields",
                "label": "Reorder fields",
                "form": {
                    "endpoint": "reorderExtraFields"
                }
            }
        ],
        "create": {
            "viewId": "extraFieldDetail",
            "presentation": "page",
            "label": "Add field"
        }
    },
    {
        "$include": "extra-field-detail/root.json"
    }
]
