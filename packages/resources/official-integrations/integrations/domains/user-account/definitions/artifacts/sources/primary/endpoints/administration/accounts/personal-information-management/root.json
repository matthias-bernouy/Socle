[
    {
        "$include": "create-user-personal-information/root.json"
    },
    {
        "endpointId": "deleteUserPersonalInformation",
        "method": "DELETE",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-user-account/personal-information/record",
        "meta": {
            "name": "Delete user personal information",
            "description": "Delete personal information for a target CMS user."
        },
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            },
            {
                "name": "x-user-id",
                "source": {
                    "from": "computed",
                    "ref": "userID"
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object",
                    "properties": {
                        "deleted": {
                            "type": "boolean"
                        },
                        "userId": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "deleted",
                        "userId"
                    ]
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "userId": {
                    "type": "string"
                }
            },
            "required": [
                "userId"
            ]
        }
    },
    {
        "$include": "upload-user-personal-information-avatar.json"
    }
]
