{
    "id": "acceptDispute",
    "label": "Accept dispute",
    "tone": "danger",
    "placement": "more",
    "visibleWhen": {
        "all": [
            {
                "any": [
                    {
                        "value": "$resource.status",
                        "equals": "needs_response"
                    },
                    {
                        "value": "$resource.status",
                        "equals": "warning_needs_response"
                    }
                ]
            },
            {
                "value": "$resource.evidenceStatus",
                "notEquals": "accepted"
            },
            {
                "value": "$resource.evidenceStatus",
                "notEquals": "closed"
            }
        ]
    },
    "form": {
        "endpoint": "acceptStripeDispute",
        "confirm": "Accept this dispute as lost? This action is irreversible.",
        "hiddenFields": [
            {
                "name": "disputeId",
                "value": "$resource.id",
                "type": "string"
            },
            {
                "name": "acceptanceOperationId",
                "value": "$resource.updatedAt",
                "type": "string"
            },
            {
                "name": "confirmation",
                "value": "ACCEPT STRIPE DISPUTE",
                "type": "string"
            }
        ],
        "sourceId": "{{dependencies.stripe.sourceId}}"
    }
}
