{
    "widget": "w-detail",
    "id": "claimDetail",
    "source": {
        "endpoint": "claim",
        "params": {
            "id": "$selection.id"
        }
    },
    "title": {
        "path": "publicId",
        "fallback": "Marketplace claim"
    },
    "status": {
        "path": "status"
    },
    "actions": [
        {
            "id": "resolveClaim",
            "label": "Resolve claim",
            "tone": "primary",
            "placement": "primary",
            "visibleWhen": {
                "any": [
                    {
                        "value": "$resource.status",
                        "equals": "open"
                    },
                    {
                        "value": "$resource.status",
                        "equals": "awaiting_seller_response"
                    },
                    {
                        "value": "$resource.status",
                        "equals": "under_review"
                    },
                    {
                        "all": [
                            {
                                "value": "$resource.status",
                                "equals": "return_required"
                            },
                            {
                                "value": "$resource.returnRecipientHandoffAt",
                                "notEquals": null
                            }
                        ]
                    }
                ]
            },
            "form": {
                "endpoint": "resolveOrderClaim",
                "confirm": "Apply this audited marketplace claim decision?",
                "hiddenFields": [
                    {
                        "name": "claimId",
                        "value": "$resource.id",
                        "type": "number"
                    },
                    {
                        "name": "expectedVersion",
                        "value": "$resource.version",
                        "type": "number"
                    }
                ],
                "fields": [
                    {
                        "id": "outcome",
                        "label": "Outcome",
                        "path": "outcome",
                        "type": "select",
                        "options": [
                            {
                                "value": "buyer",
                                "label": "Buyer"
                            },
                            {
                                "value": "seller",
                                "label": "Seller"
                            },
                            {
                                "value": "split",
                                "label": "Split"
                            },
                            {
                                "value": "return_required",
                                "label": "Return required"
                            }
                        ],
                        "name": "outcome",
                        "required": true
                    },
                    {
                        "id": "merchandiseRefundAmount",
                        "label": "Merchandise refund (minor units)",
                        "path": "merchandiseRefundAmount",
                        "type": "number",
                        "min": 0,
                        "step": 1,
                        "required": true,
                        "name": "merchandiseRefundAmount",
                        "valueType": "number"
                    },
                    {
                        "id": "shippingRefundAmount",
                        "label": "Shipping refund (minor units)",
                        "path": "shippingRefundAmount",
                        "type": "number",
                        "min": 0,
                        "step": 1,
                        "required": true,
                        "name": "shippingRefundAmount",
                        "valueType": "number"
                    },
                    {
                        "id": "sellerTransferAmount",
                        "label": "Seller transfer amount (minor units)",
                        "path": "sellerTransferAmount",
                        "type": "number",
                        "min": 0,
                        "step": 1,
                        "required": true,
                        "name": "sellerTransferAmount",
                        "valueType": "number"
                    },
                    {
                        "id": "protectionFeeRefundAmount",
                        "label": "Protection fee refund (minor units)",
                        "path": "protectionFeeRefundAmount",
                        "type": "number",
                        "min": 0,
                        "step": 1,
                        "required": true,
                        "name": "protectionFeeRefundAmount",
                        "valueType": "number"
                    },
                    {
                        "id": "decisionReason",
                        "label": "Decision reason",
                        "path": "decisionReason",
                        "type": "textarea",
                        "name": "decisionReason",
                        "required": true
                    }
                ]
            }
        }
    ],
    "main": {
        "$include": "main.json"
    }
}
