{
    "id": "submitEvidence",
    "label": "Submit final evidence",
    "tone": "danger",
    "placement": "more",
    "visibleWhen": {
        "all": [
            {
                "value": "$resource.stagedEvidenceOperationId",
                "notEquals": null
            },
            {
                "value": "$resource.evidenceStatus",
                "equals": "staged"
            }
        ]
    },
    "form": {
        "endpoint": "submitStripeDisputeEvidence",
        "confirm": "Submit the final irreversible evidence response to Stripe?",
        "hiddenFields": [
            {
                "name": "disputeId",
                "value": "$resource.id",
                "type": "string"
            },
            {
                "name": "submissionOperationId",
                "value": "$resource.updatedAt",
                "type": "string"
            },
            {
                "name": "evidenceOperationId",
                "value": "$resource.stagedEvidenceOperationId",
                "type": "string"
            },
            {
                "name": "confirmation",
                "value": "SUBMIT STRIPE EVIDENCE",
                "type": "string"
            }
        ],
        "sourceId": "{{dependencies.stripe.sourceId}}"
    }
}
