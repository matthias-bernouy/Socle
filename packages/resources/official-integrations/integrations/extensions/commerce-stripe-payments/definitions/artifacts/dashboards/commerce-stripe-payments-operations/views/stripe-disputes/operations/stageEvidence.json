{
    "id": "stageEvidence",
    "label": "Stage evidence",
    "placement": "primary",
    "visibleWhen": {
        "all": [
            {
                "value": "$resource.evidenceStatus",
                "notEquals": "submitted"
            },
            {
                "value": "$resource.evidenceStatus",
                "notEquals": "accepted"
            },
            {
                "value": "$resource.evidenceStatus",
                "notEquals": "closed"
            },
            {
                "value": "$resource.status",
                "notEquals": "won"
            },
            {
                "value": "$resource.status",
                "notEquals": "lost"
            },
            {
                "value": "$resource.status",
                "notEquals": "prevented"
            },
            {
                "value": "$resource.status",
                "notEquals": "warning_closed"
            }
        ]
    },
    "form": {
        "endpoint": "stageStripeDisputeEvidence",
        "hiddenFields": [
            {
                "name": "disputeId",
                "value": "$resource.id",
                "type": "string"
            },
            {
                "name": "evidenceOperationId",
                "value": "$resource.updatedAt",
                "type": "string"
            }
        ],
        "fields": [
            {
                "id": "evidenceText",
                "label": "Evidence statement",
                "path": "evidenceText",
                "type": "textarea",
                "name": "evidenceText"
            },
            {
                "id": "shippingTrackingNumber",
                "label": "Tracking number",
                "path": "shippingTrackingNumber",
                "type": "text",
                "name": "shippingTrackingNumber"
            },
            {
                "id": "shippingDate",
                "label": "Shipping date",
                "path": "shippingDate",
                "type": "text",
                "name": "shippingDate"
            },
            {
                "id": "shippingDocumentationFileId",
                "label": "Shipping document file id",
                "path": "shippingDocumentationFileId",
                "type": "text",
                "name": "shippingDocumentationFileId"
            },
            {
                "id": "customerCommunicationFileId",
                "label": "Customer communication file id",
                "path": "customerCommunicationFileId",
                "type": "text",
                "name": "customerCommunicationFileId"
            }
        ],
        "sourceId": "{{dependencies.stripe.sourceId}}"
    }
}
