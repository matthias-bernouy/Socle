{
    "widget": "w-detail",
    "id": "stripeDisputeDetail",
    "source": {
        "sourceId": "{{dependencies.stripe.sourceId}}",
        "endpoint": "getStripeDispute",
        "params": {
            "disputeId": "$selection.id"
        }
    },
    "title": {
        "path": "id",
        "fallback": "Stripe dispute"
    },
    "status": {
        "path": "status"
    },
    "actions": {
        "$include": "actions.json"
    },
    "main": {
        "$include": "detail-sections/root.json"
    }
}
