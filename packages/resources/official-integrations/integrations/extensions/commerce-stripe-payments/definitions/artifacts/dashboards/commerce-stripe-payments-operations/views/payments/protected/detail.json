{
    "widget": "w-detail",
    "id": "protectedPaymentDetail",
    "source": {
        "endpoint": "protectedPayment",
        "params": {
            "orderId": "$selection.id"
        }
    },
    "title": {
        "path": "orderNumber",
        "fallback": "Protected payment"
    },
    "status": {
        "path": "settlementStatus"
    },
    "actions": [
        {
            "id": "authorizeRelease",
            "label": "Authorize release",
            "tone": "primary",
            "placement": "primary",
            "visibleWhen": {
                "any": [
                    {
                        "value": "$resource.settlementStatus",
                        "equals": "held"
                    },
                    {
                        "value": "$resource.settlementStatus",
                        "equals": "eligible"
                    }
                ]
            },
            "form": {
                "endpoint": "authorizeOrderRelease",
                "confirm": "Authorize the policy-eligible seller transfer?",
                "hiddenFields": [
                    {
                        "name": "orderId",
                        "value": "$resource.orderId",
                        "type": "number"
                    },
                    {
                        "name": "expectedSettlementVersion",
                        "value": "$resource.settlement.version",
                        "type": "number"
                    }
                ],
                "fields": [
                    {
                        "id": "releaseReason",
                        "label": "Release reason",
                        "path": "releaseReason",
                        "type": "text",
                        "name": "reason"
                    }
                ]
            }
        },
        {
            "id": "requestRefund",
            "label": "Request refund",
            "tone": "danger",
            "placement": "more",
            "form": {
                "endpoint": "requestOrderRefund",
                "confirm": "Create this policy-bounded refund request?",
                "hiddenFields": [
                    {
                        "name": "orderId",
                        "value": "$resource.orderId",
                        "type": "number"
                    }
                ],
                "fields": [
                    {
                        "id": "refundReason",
                        "label": "Refund reason",
                        "path": "refundReason",
                        "type": "textarea",
                        "name": "reason",
                        "required": true
                    },
                    {
                        "id": "merchandiseRefundAmount",
                        "label": "Merchandise refund (minor units)",
                        "path": "merchandiseRefundAmount",
                        "type": "number",
                        "min": 0,
                        "step": 1,
                        "required": true,
                        "name": "merchandiseRefundAmount",
                        "valueType": "number"
                    },
                    {
                        "id": "shippingRefundAmount",
                        "label": "Shipping refund (minor units)",
                        "path": "shippingRefundAmount",
                        "type": "number",
                        "min": 0,
                        "step": 1,
                        "required": true,
                        "name": "shippingRefundAmount",
                        "valueType": "number"
                    },
                    {
                        "id": "protectionFeeRefundAmount",
                        "label": "Protection fee refund (minor units)",
                        "path": "protectionFeeRefundAmount",
                        "type": "number",
                        "min": 0,
                        "step": 1,
                        "required": true,
                        "name": "protectionFeeRefundAmount",
                        "valueType": "number"
                    }
                ]
            }
        }
    ],
    "main": {
        "$include": "sections.json"
    },
    "aside": [
        {
            "id": "deadlines",
            "title": "Protection",
            "fields": [
                {
                    "id": "recipientHandoffAt",
                    "label": "Recipient handoff",
                    "path": "recipientHandoffAt",
                    "type": "readonly",
                    "format": "date"
                },
                {
                    "id": "releaseEligibleAt",
                    "label": "Release eligible",
                    "path": "releaseEligibleAt",
                    "type": "readonly",
                    "format": "date"
                },
                {
                    "id": "totalRefundRequestedAmount",
                    "label": "Refund requested",
                    "path": "totalRefundRequestedAmount",
                    "type": "readonly",
                    "format": "money"
                }
            ]
        }
    ]
}
