{
    "widget": "w-detail",
    "id": "refundRequestDetail",
    "source": {
        "endpoint": "refundRequest",
        "params": {
            "id": "$selection.id"
        }
    },
    "title": {
        "path": "id",
        "fallback": "Refund request"
    },
    "status": {
        "path": "status"
    },
    "actions": [
        {
            "id": "reviewRefund",
            "label": "Review refund",
            "tone": "primary",
            "placement": "primary",
            "visibleWhen": {
                "value": "$resource.status",
                "equals": "requested"
            },
            "form": {
                "endpoint": "reviewOrderRefund",
                "confirm": "Apply this finance review decision?",
                "hiddenFields": [
                    {
                        "name": "refundRequestId",
                        "value": "$resource.id",
                        "type": "number"
                    },
                    {
                        "name": "expectedVersion",
                        "value": "$resource.version",
                        "type": "number"
                    }
                ],
                "fields": [
                    {
                        "id": "decision",
                        "label": "Decision",
                        "path": "decision",
                        "type": "select",
                        "options": [
                            {
                                "value": "approved",
                                "label": "Approve"
                            },
                            {
                                "value": "rejected",
                                "label": "Reject"
                            },
                            {
                                "value": "cancelled",
                                "label": "Cancel before provider operation"
                            }
                        ],
                        "name": "decision",
                        "required": true
                    },
                    {
                        "id": "reviewReason",
                        "label": "Review reason",
                        "path": "reviewReason",
                        "type": "textarea",
                        "name": "reason",
                        "required": true
                    }
                ]
            }
        }
    ],
    "main": {
        "$include": "detail-sections.json"
    }
}
