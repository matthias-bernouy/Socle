{
    "widget": "w-detail",
    "id": "proposalDetail",
    "source": {
        "endpoint": "manageProposal",
        "params": {
            "id": "$selection.id"
        }
    },
    "title": {
        "path": "offerTitle",
        "fallback": "Price proposal"
    },
    "status": {
        "path": "status"
    },
    "actions": [
        {
            "id": "cancelProposal",
            "label": "Cancel proposal",
            "tone": "danger",
            "placement": "more",
            "visibleWhen": {
                "any": [
                    {
                        "value": "$resource.status",
                        "equals": "pending"
                    },
                    {
                        "value": "$resource.status",
                        "equals": "accepted"
                    }
                ]
            },
            "form": {
                "endpoint": "cancelProposal",
                "confirm": "Cancel this proposal?",
                "hiddenFields": [
                    {
                        "name": "id",
                        "value": "$resource.id",
                        "type": "number"
                    },
                    {
                        "name": "expectedVersion",
                        "value": "$resource.version",
                        "type": "number"
                    }
                ],
                "fields": [
                    {
                        "id": "cancellationReason",
                        "label": "Cancellation reason",
                        "path": "cancellationReason",
                        "type": "textarea",
                        "rows": 3,
                        "name": "reason"
                    }
                ]
            }
        }
    ],
    "main": {
        "$include": "main.json"
    },
    "aside": [
        {
            "id": "proposalParties",
            "title": "Parties",
            "fields": [
                {
                    "id": "sellerDisplayName",
                    "label": "Seller",
                    "path": "sellerDisplayName",
                    "type": "readonly"
                },
                {
                    "id": "sellerUserId",
                    "label": "Seller user",
                    "path": "sellerUserId",
                    "type": "readonly"
                },
                {
                    "id": "buyerUserId",
                    "label": "Buyer user",
                    "path": "buyerUserId",
                    "type": "readonly"
                },
                {
                    "id": "status",
                    "label": "Status",
                    "path": "status",
                    "type": "readonly",
                    "format": "badge"
                },
                {
                    "id": "expiresAt",
                    "label": "Expires",
                    "path": "expiresAt",
                    "type": "readonly",
                    "format": "date"
                }
            ]
        }
    ]
}
