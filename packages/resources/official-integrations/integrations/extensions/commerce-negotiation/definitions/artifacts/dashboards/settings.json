{
    "type": "dashboard-view",
    "view": {
        "id": "commerce-negotiation-settings",
        "source": "commerce-negotiation",
        "meta": {
            "name": "Negotiation settings",
            "icon": {
                "path": "assets/icon.svg"
            }
        },
        "views": [
            {
                "widget": "w-detail",
                "id": "negotiationSettings",
                "source": {
                    "endpoint": "settings"
                },
                "title": {
                    "path": "id",
                    "fallback": "Negotiation settings"
                },
                "actions": [],
                "main": [
                    {
                        "id": "policy",
                        "title": "Price bounds",
                        "fields": [
                            {
                                "id": "minimumPercent",
                                "label": "Minimum percent",
                                "path": "minimumPercent",
                                "type": "number",
                                "required": true,
                                "name": "minimumPercent",
                                "valueType": "number"
                            },
                            {
                                "id": "maximumPercent",
                                "label": "Maximum percent",
                                "path": "maximumPercent",
                                "type": "number",
                                "required": true,
                                "name": "maximumPercent",
                                "valueType": "number"
                            },
                            {
                                "id": "proposalTtlHours",
                                "label": "Proposal lifetime in hours",
                                "path": "proposalTtlHours",
                                "type": "number",
                                "required": true,
                                "name": "proposalTtlHours",
                                "valueType": "number"
                            },
                            {
                                "id": "acceptedCheckoutTtlHours",
                                "label": "Accepted checkout lifetime in hours",
                                "path": "acceptedCheckoutTtlHours",
                                "type": "number",
                                "required": true,
                                "name": "acceptedCheckoutTtlHours",
                                "valueType": "number"
                            },
                            {
                                "id": "enabled",
                                "label": "Enabled",
                                "path": "enabled",
                                "type": "checkbox",
                                "name": "enabled",
                                "valueType": "boolean"
                            }
                        ]
                    }
                ],
                "save": {
                    "endpoint": "updateSettings",
                    "hiddenFields": [
                        {
                            "name": "expectedVersion",
                            "value": "$resource.version",
                            "type": "number"
                        }
                    ],
                    "label": "Save settings"
                }
            }
        ]
    }
}
