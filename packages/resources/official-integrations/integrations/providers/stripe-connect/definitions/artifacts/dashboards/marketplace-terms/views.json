[
    {
        "widget": "w-detail",
        "id": "marketplaceTerms",
        "source": {
            "endpoint": "getMarketplaceTermsManagement"
        },
        "title": {
            "path": "label",
            "fallback": "Seller terms"
        },
        "status": {
            "path": "status"
        },
        "main": [
            {
                "id": "document",
                "title": "Runtime seller policy",
                "description": "Publishing downloads the current CMS page snapshot, verifies its digest, and creates an immutable version.",
                "fields": [
                    {
                        "id": "documentKey",
                        "label": "Stable key",
                        "path": "documentKey",
                        "type": "text",
                        "required": true
                    },
                    {
                        "id": "label",
                        "label": "Public label",
                        "path": "label",
                        "type": "text",
                        "required": true
                    },
                    {
                        "id": "consentText",
                        "label": "Consent sentence",
                        "path": "consentText",
                        "type": "textarea",
                        "required": true
                    },
                    {
                        "id": "page",
                        "label": "Published page",
                        "path": "page",
                        "type": "page-link",
                        "publishedOnly": true,
                        "required": true
                    }
                ]
            }
        ],
        "aside": [
            {
                "id": "publication",
                "title": "Publication",
                "fields": [
                    {
                        "id": "status",
                        "label": "Status",
                        "path": "status",
                        "type": "readonly",
                        "format": "badge"
                    },
                    {
                        "id": "revision",
                        "label": "Current version",
                        "path": "revision",
                        "type": "readonly"
                    },
                    {
                        "id": "updatedAt",
                        "label": "Updated",
                        "path": "updatedAt",
                        "type": "readonly",
                        "format": "date"
                    }
                ]
            }
        ],
        "save": {
            "management": {
                "installationId": "stripe-connect",
                "operation": "action",
                "actionId": "publish-seller-terms"
            },
            "valuesPath": "input",
            "label": "Publish seller terms",
            "confirm": "Publish this immutable seller terms version? Existing seller acceptances remain attached to their original version.",
            "hiddenFields": [
                {
                    "name": "input[expectedVersion]",
                    "type": "string",
                    "value": "$resource.revision"
                }
            ]
        }
    }
]
