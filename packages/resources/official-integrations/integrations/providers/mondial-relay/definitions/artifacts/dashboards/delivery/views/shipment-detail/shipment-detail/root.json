{
    "widget": "w-detail",
    "id": "shipmentDetail",
    "source": {
        "endpoint": "shipment",
        "params": {
            "id": "$selection.id"
        }
    },
    "title": {
        "path": "expeditionNumber",
        "fallback": "Shipment"
    },
    "status": {
        "path": "status"
    },
    "actions": [
        {
            "id": "recoverUnknownShipment",
            "label": "Recover unknown shipment",
            "tone": "danger",
            "placement": "more",
            "visibleWhen": {
                "value": "$resource.status",
                "equals": "unknown"
            },
            "form": {
                "endpoint": "recoverUnknownShipment",
                "confirm": "Attach this verified Mondial Relay shipment to the ambiguous reservation?",
                "hiddenFields": [
                    {
                        "name": "shipmentId",
                        "value": "$resource.id",
                        "type": "string"
                    },
                    {
                        "name": "externalOrderId",
                        "value": "$resource.externalOrderId",
                        "type": "string"
                    }
                ],
                "fields": [
                    {
                        "id": "recoveryExpeditionNumber",
                        "label": "Verified expedition number",
                        "path": "recoveryExpeditionNumber",
                        "type": "text",
                        "name": "expeditionNumber",
                        "required": true
                    },
                    {
                        "id": "recoveryLabelUrl",
                        "label": "Verified provider label URL",
                        "path": "recoveryLabelUrl",
                        "type": "text",
                        "name": "labelUrl"
                    },
                    {
                        "id": "recoveryReason",
                        "label": "Recovery reason",
                        "path": "recoveryReason",
                        "type": "textarea",
                        "rows": 3,
                        "name": "reason",
                        "required": true
                    }
                ]
            }
        }
    ],
    "main": {
        "$include": "main.json"
    },
    "aside": [
        {
            "id": "shipmentLinks",
            "title": "Links",
            "fields": [
                {
                    "id": "trackingUrl",
                    "label": "Tracking URL",
                    "path": "trackingUrl",
                    "type": "readonly",
                    "format": "url"
                },
                {
                    "id": "latestEventLabel",
                    "label": "Latest event",
                    "path": "latestEventLabel",
                    "type": "readonly"
                },
                {
                    "id": "latestEventAt",
                    "label": "Latest event date",
                    "path": "latestEventAt",
                    "type": "readonly",
                    "format": "date"
                },
                {
                    "id": "createdAt",
                    "label": "Created",
                    "path": "createdAt",
                    "type": "readonly",
                    "format": "date"
                }
            ]
        }
    ]
}
