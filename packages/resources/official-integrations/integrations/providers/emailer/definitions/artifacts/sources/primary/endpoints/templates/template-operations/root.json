[
    {
        "endpointId": "getTemplate",
        "method": "GET",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-emailer/template",
        "params": [
            {
                "name": "key",
                "in": "query",
                "type": "string",
                "required": false
            }
        ],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ]
    },
    {
        "$include": "upsert-template.json"
    },
    {
        "endpointId": "archiveTemplate",
        "method": "POST",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-emailer/template/archive",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "key": {
                    "type": "string"
                }
            },
            "required": [
                "key"
            ]
        }
    },
    {
        "$include": "render-template.json"
    },
    {
        "endpointId": "sendTestEmail",
        "method": "POST",
        "access": "admin",
        "targetUrl": "{{connectors.supabase.functionsBaseUrl}}/cms-emailer/template/send-test",
        "params": [],
        "headers": [
            {
                "name": "authorization",
                "source": {
                    "from": "secret",
                    "ref": "{{secrets.cmsApiKey}}",
                    "prefix": "Bearer "
                }
            }
        ],
        "body": {
            "type": "object",
            "properties": {
                "key": {
                    "type": "string"
                },
                "toEmail": {
                    "type": "string"
                },
                "data": {
                    "type": "object"
                },
                "sampleDataJson": {
                    "type": "string"
                }
            },
            "required": [
                "key",
                "toEmail"
            ]
        },
        "output": [
            {
                "status": "200",
                "body": {
                    "type": "object"
                }
            }
        ]
    },
    {
        "$include": "send-template-email.json"
    },
    {
        "$include": "install-templates.json"
    }
]
