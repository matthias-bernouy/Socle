{
    "widget": "w-detail",
    "id": "templateDetail",
    "source": {
        "endpoint": "getTemplate",
        "params": {
            "key": "$selection.id"
        }
    },
    "title": {
        "path": "name",
        "fallback": "Template"
    },
    "status": {
        "path": "status"
    },
    "actions": [
        {
            "id": "sendTestEmail",
            "label": "Send test",
            "placement": "secondary",
            "form": {
                "endpoint": "sendTestEmail",
                "fields": [
                    {
                        "id": "testRecipient",
                        "label": "Test recipient",
                        "type": "text",
                        "path": "testRecipient",
                        "name": "toEmail",
                        "required": true
                    }
                ],
                "hiddenFields": [
                    {
                        "name": "key",
                        "value": "$resource.key",
                        "type": "string"
                    }
                ]
            }
        },
        {
            "id": "archiveTemplate",
            "label": "Archive",
            "tone": "danger",
            "placement": "more",
            "form": {
                "endpoint": "archiveTemplate",
                "confirm": "Archive this template?",
                "hiddenFields": [
                    {
                        "name": "key",
                        "value": "$resource.key",
                        "type": "string"
                    }
                ]
            }
        }
    ],
    "main": {
        "$include": "main.json"
    },
    "aside": [
        {
            "id": "sender",
            "title": "Sender",
            "fields": [
                {
                    "id": "fromEmail",
                    "label": "From override",
                    "type": "text",
                    "path": "fromEmail",
                    "name": "fromEmail"
                },
                {
                    "id": "replyTo",
                    "label": "Reply-to override",
                    "type": "text",
                    "path": "replyTo",
                    "name": "replyTo"
                }
            ]
        }
    ],
    "save": {
        "endpoint": "upsertTemplate",
        "label": "Save",
        "idPath": "key"
    },
    "create": {
        "label": "Create"
    }
}
